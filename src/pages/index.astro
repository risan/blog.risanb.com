---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import TagIcon from '../components/TagIcon.astro';
import RiverScene from '../components/RiverScene.astro';
import { postHref } from '../lib/posts';
import risanPhoto from '../assets/risan.webp';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Hand-picked long reads for "Sorotan Utama".
const featuredIds = [
  'bertualang-ke-karimunjawa',
  'stasiun-stasiun-tunnelbana',
  'enam-hal-yang-mengagumkan-dari-swedia',
  'angin-dingin-dari-siberia',
  'petualangan-imajiner',
];

const featuredPosts = featuredIds
  .map((id) => posts.find((p) => p.id === id || p.id === `${id}/index`))
  .filter((p): p is (typeof posts)[0] => Boolean(p));

const recentPosts = posts.filter((p) => !featuredPosts.includes(p)).slice(0, 5);

const photoPosts = posts
  .filter((p) => p.data.categories.includes('photos') && p.data.images.length > 0)
  .slice(0, 6);

// Tag frequencies
const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sortedTags = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout
  title="Risan Bagja"
  description="Jurnal pribadi, catatan perjalanan, dan cerita-cerita yang patut diingat dari Risan Bagja."
>
  <div class="shell">
    {/* Bold Intro Header & Magazine 2-Column Spread with Photo */}
    <section class="home-intro">
      <h1>Yang Sempat Saya Tulis</h1>

      <div class="home-intro-spread">
        <p>
          Dulu saya sering memotret kereta, stasiun yang saya singgahi, deretan pegunungan, ombak yang bergulung, pantai, hutan pinus, bangunan-bangunan tua, atau matahari saat terbenam. Sekarang, saat membuka galeri, yang paling ingin saya lihat justru senyum manis Dwi, istri saya, dan tingkah lucu Kinanti, putri kecil kami yang tak kenal lelah.
        </p>
        <p>
          Saya masih suka membuka peta. Tapi yang saya cari sekarang: bagian mana dari Tour du Mont Blanc yang ramah untuk anak? Seberapa jauh jarak antarpenginapan, dan di mana kami bisa makan di sepanjang Danube Cycle Path dari Passau ke Wina? Semuanya belum punya tanggal keberangkatan. Tapi ketika saatnya tiba, setidaknya kami sudah siap.
        </p>
        <p>
          Pagi atau sore ketika saya tidak terlalu sibuk, kami bertiga berjalan ke kafe dekat rumah. Sepanjang jalan Kinanti menyapa anjing atau ayam, memetik dandelion, lalu meniti tepian got seolah ikut <em>Ninja Warrior</em>. Entah kenapa, hanya dalam perjalanan ke kafe itulah ia mau menghabiskan susunya.
        </p>
        <p>
          Untuk sekarang, kami cukup hiking ke air terjun dekat rumah atau bersepeda ke kota tetangga. Sesekali kami naik kereta ke luar kota. Kadang ke Jakarta untuk melihat akuarium. Pernah juga semalam di Cirebon untuk bernostalgia. Bersepeda keliling Pecinan di Semarang. Melihat Candi Borobudur di Magelang. Atau mampir ke Solo untuk <del>ketemu Jokowi</del> wisata kuliner.
        </p>

        <figure class="home-intro-figure">
          <Image
            src={risanPhoto}
            alt="Risan Bagja melihat ke luar jendela kereta"
            class="home-intro-photo"
            loading="eager"
            fetchpriority="high"
            widths={[380, 520, 760, 1176]}
            sizes="(max-width: 768px) 100vw, 540px"
          />
          <figcaption class="home-intro-caption">Foto candid yang saya sadari dari awal.</figcaption>
        </figure>

        <p>
          Di sini saya menyimpan cerita perjalanan, foto, buku-buku dari masa ketika saya lebih rajin membaca, dan hal-hal kecil yang ingin saya tulis. Saya ingin mulai menambah cerita baru di sampingnya, kalau bisa sebelum rencana perjalanan berikutnya bertambah lagi.
        </p>
      </div>
    </section>

    {/* Dua Kolom: Sorotan Utama & Tulisan Terkini */}
    <div class="home-columns">
      <section class="section-block">
        <div class="sechead">
          <h3>Sorotan Utama</h3>
          <span class="eyebrow-pill">Pilihan</span>
        </div>
        <PostList posts={featuredPosts} />
      </section>

      <section class="section-block">
        <div class="sechead">
          <h3>Tulisan Terkini</h3>
          <a href="/arsip/">Semua ({posts.length}) →</a>
        </div>
        <PostList posts={recentPosts} />
      </section>
    </div>
    {
      photoPosts.length > 0 && (
        <section class="section-block" style="margin-top: 64px;">
          <div class="sechead">
            <h3>Galeri Foto</h3>
            <a href="/categories/photos/">Lihat semua →</a>
          </div>
          <div class="strip">
            {photoPosts.map((post, i) => (
              <a href={postHref(post.id)}>
                <Image
                  src={post.data.images[0]}
                  width={i === 0 ? 720 : 360}
                  height={i === 0 ? 720 : 360}
                  sizes={
                    i === 0
                      ? '(min-width: 1180px) 543px, (min-width: 821px) calc(50vw - 47px), calc(100vw - 40px)'
                      : '(min-width: 1180px) 264px, (min-width: 821px) calc(25vw - 30px), calc(50vw - 25px)'
                  }
                  fit="cover"
                  alt=""
                />
                <span class="strip-body">{post.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {/* Section: Tag Clouds */}
    <section class="section-block" style="margin-top: 72px;">
      <div class="sechead">
        <h3>Tags</h3>
        <a href="/tags/">Semua tag →</a>
      </div>
      <div class="tag-cloud">
        {
          sortedTags.map(([name, count]) => (
            <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
              <TagIcon name={name} />
              <span class="tag-name">#{name}</span>
              <span class="tag-count">{count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <RiverScene />
  </div>
</BaseLayout>

<style>
  .home-intro {
    max-width: 100%;
    padding: 32px 0 0;
  }

  .home-intro h1 {
    font-size: clamp(2.35rem, 5.2vw, 3.6rem);
    line-height: 1.08;
    margin: 0;
    font-family: var(--font-disp);
    letter-spacing: -0.02em;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--ink);
  }

  .home-intro h1 .accent-word {
    color: var(--terra);
  }

  .home-intro-spread {
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    .home-intro-spread {
      columns: 2;
      column-gap: 52px;
      margin-top: 36px;
    }
  }

  .home-intro-spread p {
    margin: 20px 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .home-intro-spread p:first-of-type {
    margin-top: 0;
  }

  .home-intro-spread p:first-of-type::first-letter {
    initial-letter: 2;
    -webkit-initial-letter: 2;
    float: left;
    font-family: var(--font-disp);
    font-size: 3.4rem;
    line-height: 0.85;
    font-weight: 500;
    color: var(--terra);
    margin: 0.04em 0.14em 0 0;
  }

  .home-intro-figure {
    break-inside: avoid;
    margin: 24px 0;
  }

  .home-intro-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 63%;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--sand-2);
  }

  .home-intro-caption {
    font-family: var(--font-disp);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
    margin-top: 10px;
    padding: 0 8px;
  }

  /* Dua Kolom: Sorotan Utama & Tulisan Terkini */
  .home-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 56px;
  }

  @media (min-width: 768px) {
    .home-columns {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (min-width: 1024px) {
    .home-columns {
      gap: 48px;
    }
  }

  .home-columns .section-block {
    margin-top: 0;
    min-width: 0;
  }

  .eyebrow-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra);
    background: var(--sand-2);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--rule);
  }
</style>
