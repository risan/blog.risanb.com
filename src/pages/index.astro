---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagIcon from '../components/TagIcon.astro';
import { toPlainText } from '../lib/plain-text';
import risanPhoto from '../assets/risan.webp';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Pick the primary featured post that has an image
const featuredPost = posts.find((p) => p.data.featured && p.data.images.length > 0) ?? posts[0];

// Recent posts (excluding the featured one to avoid immediate repetition)
const remaining = posts.filter((p) => p.id !== featuredPost.id);
const recentPosts = remaining.slice(0, 6);

// Photo & travel strip (3 visual posts with photos)
const photoPosts = posts
  .filter(
    (p) =>
      p.id !== featuredPost.id &&
      p.data.images.length > 0 &&
      (p.data.categories.includes('photos') || p.data.categories.includes('travel')),
  )
  .slice(0, 3);

// Tag frequencies
const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sortedTags = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const href = (id: string) => `/${id.replace(/\/index$/, '')}/`;

const excerpt = (post: (typeof posts)[0]) => {
  if (post.data.description) return post.data.description;
  if (!post.body) return '';
  const text = toPlainText(post.body);
  return text.length > 130 ? `${text.slice(0, 130).trim()}…` : text;
};

const categoryLabel = (cats: string[]) => {
  if (!cats || cats.length === 0) return 'Catatan';
  const c = cats[0].toLowerCase();
  if (c === 'travel') return 'Perjalanan';
  if (c === 'writing') return 'Tulisan';
  if (c === 'journal') return 'Catatan';
  if (c === 'photos') return 'Foto';
  return cats[0];
};
---

<BaseLayout
  title="Risan Bagja"
  description="Jurnal pribadi, catatan perjalanan, dan cerita-cerita yang patut diingat dari Risan Bagja."
>
  <div class="shell">
    {/* Bold Intro Header & Magazine 2-Column Spread with Photo */}
    <section class="home-intro">
      <h1>Cerita, <span class="accent-word">perjalanan</span>, dan hal-hal yang singgah di ingatan</h1>

      <div class="home-intro-spread">
        <p>
          Halo, saya Risan. Sehari-hari saya menulis kode dan merancang perangkat lunak.
          Ketertarikan itu bermula sejak bangku SMP, saat saya iseng membaca buku pemrograman lawas
          dan membuat editor teks sederhana. Sejak saat itu, rasa ingin tahu untuk membuat sesuatu selalu ada.
        </p>
        <p>
          Namun di sela-sela rutinitas di depan layar, saya selalu menemukan ruang untuk jeda:
          menempuh rute baru dengan sepeda, duduk membaca buku fiksi, mengamati sudut-sudut kota yang
          belum pernah disinggahi, atau sekadar memperhatikan hal-hal kecil yang kerap terlewatkan saat kita tergesa-gesa.
        </p>

        <figure class="home-intro-figure">
          <Image
            src={risanPhoto}
            alt="Risan Bagja melihat ke luar jendela kereta"
            class="home-intro-photo"
            loading="eager"
            fetchpriority="high"
            widths={[380, 520, 760, 1176]}
            sizes="(max-width: 768px) 100vw, 540px"
          />
          <figcaption class="home-intro-caption">Melihat ke luar jendela kereta — cara sederhana untuk melambat.</figcaption>
        </figure>

        <p>
          Situs ini adalah jurnal pribadi tempat saya mengarsipkan cerita perjalanan, ulasan buku,
          dan catatan harian yang sempat dituliskan. Bukan panduan wisata, melainkan sekadar rekaman jujur
          dari waktu yang pernah dilalui. Semoga ada cerita di sini yang terasa dekat.
        </p>
      </div>
    </section>

    {/* Featured Hero */}
    {
      featuredPost && (
        <a class="featured" href={href(featuredPost.id)}>
          {featuredPost.data.images[0] && (
            <div class="ph">
              <Image
                src={featuredPost.data.images[0]}
                width={1080}
                height={480}
                alt={featuredPost.data.title}
                loading="eager"
              />
            </div>
          )}
          <div class="body">
            <span class="cat-badge">{categoryLabel(featuredPost.data.categories)}</span>
            <h2>{featuredPost.data.title}</h2>
            <p>{excerpt(featuredPost)}</p>
            <span class="when">{fmt(featuredPost.data.date)}</span>
          </div>
        </a>
      )
    }

    {/* Section: Catatan Terbaru */}
    <div class="sechead" style="margin-top: 64px;">
      <h3>Catatan Terbaru</h3>
      <a href="/arsip/">Semua catatan ({posts.length}) →</a>
    </div>

    <ul class="entries">
      {
        recentPosts.map((post) => {
          const cover = post.data.images[0];
          return (
            <li>
              <a href={href(post.id)} class={cover ? '' : 'no-thumb'}>
                {cover && (
                  <span class="thumb">
                    <Image src={cover} width={280} height={210} alt="" />
                  </span>
                )}
                <span>
                  <h4>{post.data.title}</h4>
                  <p>{excerpt(post)}</p>
                  <span class="when">
                    {fmt(post.data.date)} · {categoryLabel(post.data.categories)}
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    {/* Section: Foto & Perjalanan */}
    {
      photoPosts.length > 0 && (
        <>
          <div class="sechead" style="margin-top: 64px;">
            <h3>Foto &amp; Perjalanan</h3>
            <a href="/categories/photos/">Galeri foto →</a>
          </div>
          <div class="strip">
            {photoPosts.map((post) => (
              <a href={href(post.id)} title={post.data.title}>
                <Image src={post.data.images[0]} width={360} height={360} alt={post.data.title} />
                <div class="strip-body">{post.data.title}</div>
              </a>
            ))}
          </div>
        </>
      )
    }

    {/* Section: Tag Clouds */}
    <section class="section-block" style="margin-top: 72px;">
      <div class="sechead">
        <h3>Tags</h3>
        <a href="/tags/">Semua tag →</a>
      </div>
      <div class="tag-cloud">
        {
          sortedTags.map(([name, count]) => (
            <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
              <TagIcon name={name} />
              <span class="tag-name">#{name}</span>
              <span class="tag-count">{count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-intro {
    max-width: 100%;
    padding: 32px 0 0;
  }

  .home-intro h1 {
    font-size: clamp(2.35rem, 5.2vw, 3.6rem);
    line-height: 1.08;
    margin: 0;
    font-family: var(--font-disp);
    letter-spacing: -0.02em;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--ink);
  }

  .home-intro h1 .accent-word {
    color: var(--terra);
  }

  .home-intro-spread {
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    .home-intro-spread {
      columns: 2;
      column-gap: 52px;
      margin-top: 36px;
    }
  }

  .home-intro-spread p {
    margin: 20px 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .home-intro-spread p:first-of-type {
    margin-top: 0;
  }

  .home-intro-spread p:first-of-type::first-letter {
    initial-letter: 2;
    -webkit-initial-letter: 2;
    float: left;
    font-family: var(--font-disp);
    font-size: 3.4rem;
    line-height: 0.85;
    font-weight: 500;
    color: var(--terra);
    margin: 0.04em 0.14em 0 0;
  }

  .home-intro-figure {
    break-inside: avoid;
    margin: 24px 0;
  }

  .home-intro-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 30%;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--sand-2);
  }

  .home-intro-caption {
    font-family: var(--font-disp);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
    margin-top: 10px;
    padding: 0 8px;
  }
</style>
