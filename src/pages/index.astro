---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import TagIcon from '../components/TagIcon.astro';
import { toPlainText } from '../lib/plain-text';
import risanPhoto from '../assets/risan.webp';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

 // 5 Best writings for "Sorotan Utama" (carefully selected featured long-form essays)
 const featuredIds = [
   'bertualang-ke-karimunjawa',
   'stasiun-stasiun-tunnelbana',
   'enam-hal-yang-mengagumkan-dari-swedia',
   'angin-dingin-dari-siberia',
   'petualangan-imajiner',
 ];
 
 const featuredPosts = featuredIds
   .map((id) => posts.find((p) => p.id === id || p.id === `${id}/index`))
   .filter((p): p is (typeof posts)[0] => Boolean(p));
 
 // 5 Recent writings for "Tulisan Terkini", excluding the ones in "Sorotan Utama"
 const recentPosts = posts
   .filter((p) => !featuredPosts.some((f) => f.id === p.id))
   .slice(0, 5);
 
 // Photo & travel strip (3 visual posts with photos, excluding featured and recent)
 const photoPosts = posts
   .filter(
     (p) =>
       !featuredPosts.some((f) => f.id === p.id) &&
       !recentPosts.some((r) => r.id === p.id) &&
       p.data.images.length > 0 &&
       (p.data.categories.includes('photos') || p.data.categories.includes('travel')),
   )
   .slice(0, 3);

// Tag frequencies
const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sortedTags = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const href = (id: string) => `/${id.replace(/\/index$/, '')}/`;

 const getThumbnail = (post: (typeof posts)[0]) => {
   // 1. Cover image from frontmatter
   if (post.data.images && post.data.images.length > 0 && post.data.images[0]) {
     return { src: post.data.images[0], attribution: null };
   }
   // 2. OpenGraph or body image fallback
   if (post.body) {
     const match = post.body.match(/!\[([^\]]*)\]\(([^)]+)\)/);
     if (match && match[2]) {
       return { src: match[2], attribution: match[1] || null };
     }
   }
   // 3. Fallback free image matching content
   return { src: risanPhoto, attribution: 'Foto oleh Risan Bagja' };
 };
 
 const excerpt = (post: (typeof posts)[0]) => {
   if (post.data.description) {
     const desc = post.data.description;
     return desc.length > 95 ? `${desc.slice(0, 95).trim()}…` : desc;
   }
   if (!post.body) return '';
   let text = toPlainText(post.body);
   if (text.toLowerCase().startsWith(post.data.title.toLowerCase())) {
     text = text.slice(post.data.title.length).trim();
   }
   return text.length > 95 ? `${text.slice(0, 95).trim()}…` : text;
 };

const categoryLabel = (cats: string[]) => {
  if (!cats || cats.length === 0) return 'Catatan';
  const c = cats[0].toLowerCase();
  if (c === 'travel') return 'Perjalanan';
  if (c === 'writing') return 'Tulisan';
  if (c === 'journal') return 'Catatan';
  if (c === 'photos') return 'Foto';
  return cats[0];
};
---

<BaseLayout
  title="Risan Bagja"
  description="Jurnal pribadi, catatan perjalanan, dan cerita-cerita yang patut diingat dari Risan Bagja."
>
  <div class="shell">
    {/* Bold Intro Header & Magazine 2-Column Spread with Photo */}
    <section class="home-intro">
      <h1>Yang Sempat Saya Tulis</h1>

      <div class="home-intro-spread">
        <p>
          Dulu saya sering memotret kereta, stasiun yang saya singgahi, deretan pegunungan, ombak yang bergulung, pantai, hutan pinus, bangunan-bangunan tua, atau matahari saat terbenam. Sekarang, saat membuka galeri, yang paling ingin saya lihat justru senyum manis Dwi, istri saya, dan tingkah lucu Kinanti, putri kecil kami yang tak kenal lelah.
        </p>
        <p>
          Saya masih suka membuka peta. Tapi yang saya cari sekarang: bagian mana dari Tour du Mont Blanc yang ramah untuk anak? Seberapa jauh jarak antarpenginapan, dan di mana kami bisa makan di sepanjang Danube Cycle Path dari Passau ke Wina? Semuanya belum punya tanggal keberangkatan. Tapi ketika saatnya tiba, setidaknya kami sudah siap.
        </p>
        <p>
          Pagi atau sore ketika saya tidak terlalu sibuk, kami bertiga berjalan ke kafe dekat rumah. Sepanjang jalan Kinanti menyapa anjing atau ayam, memetik dandelion, lalu meniti tepian got seolah ikut <em>Ninja Warrior</em>. Entah kenapa, hanya dalam perjalanan ke kafe itulah ia mau menghabiskan susunya.
        </p>
        <p>
          Untuk sekarang, kami cukup hiking ke air terjun dekat rumah atau bersepeda ke kota tetangga. Sesekali kami naik kereta ke luar kota. Kadang ke Jakarta untuk melihat akuarium. Pernah juga semalam di Cirebon untuk bernostalgia. Bersepeda keliling Pecinan di Semarang. Melihat Candi Borobudur di Magelang. Atau mampir ke Solo untuk <del>ketemu Jokowi</del> wisata kuliner.
        </p>

        <figure class="home-intro-figure">
          <Image
            src={risanPhoto}
            alt="Risan Bagja melihat ke luar jendela kereta"
            class="home-intro-photo"
            loading="eager"
            fetchpriority="high"
            widths={[380, 520, 760, 1176]}
            sizes="(max-width: 768px) 100vw, 540px"
          />
          <figcaption class="home-intro-caption">Foto candid yang saya sadari dari awal.</figcaption>
        </figure>

        <p>
          Di sini saya menyimpan cerita perjalanan, foto, buku-buku dari masa ketika saya lebih rajin membaca, dan hal-hal kecil yang ingin saya tulis. Saya ingin mulai menambah cerita baru di sampingnya, kalau bisa sebelum rencana perjalanan berikutnya bertambah lagi.
        </p>
      </div>
    </section>

    {/* Dua Kolom: Sorotan Utama & Tulisan Terkini */}
    <div class="home-columns">
      <section class="section-block">
        <div class="sechead">
          <h3>Sorotan Utama</h3>
          <span class="eyebrow-pill">Pilihan</span>
        </div>
        <ul class="home-entry-list">
          {
            featuredPosts.map((post) => {
              const thumb = getThumbnail(post);
              return (
                <li class="home-entry-item">
                  <a href={href(post.id)} class="home-entry-card">
                    {thumb && (
                      <span class="card-thumb">
                        {typeof thumb.src === 'string' ? (
                          <img src={thumb.src} width="180" height="180" alt="" loading="lazy" />
                        ) : (
                          <Image src={thumb.src} width={180} height={180} alt="" />
                        )}
                      </span>
                    )}
                    <span class="card-body">
                      <h4>{post.data.title}</h4>
                      <p class="excerpt">{excerpt(post)}</p>
                      <span class="when">
                        {fmt(post.data.date)} · {categoryLabel(post.data.categories)}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>

      <section class="section-block">
        <div class="sechead">
          <h3>Tulisan Terkini</h3>
          <a href="/arsip/">Semua ({posts.length}) →</a>
        </div>
        <ul class="home-entry-list">
          {
            recentPosts.map((post) => {
              const thumb = getThumbnail(post);
              return (
                <li class="home-entry-item">
                  <a href={href(post.id)} class="home-entry-card">
                    {thumb && (
                      <span class="card-thumb">
                        {typeof thumb.src === 'string' ? (
                          <img src={thumb.src} width="180" height="180" alt="" loading="lazy" />
                        ) : (
                          <Image src={thumb.src} width={180} height={180} alt="" />
                        )}
                      </span>
                    )}
                    <span class="card-body">
                      <h4>{post.data.title}</h4>
                      <p class="excerpt">{excerpt(post)}</p>
                      <span class="when">
                        {fmt(post.data.date)} · {categoryLabel(post.data.categories)}
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </div>
    {/* Section: Foto & Perjalanan */}
    {
      photoPosts.length > 0 && (
        <>
          <div class="sechead" style="margin-top: 64px;">
            <h3>Foto &amp; Perjalanan</h3>
            <a href="/categories/photos/">Galeri foto →</a>
          </div>
          <div class="strip">
            {photoPosts.map((post) => (
              <a href={href(post.id)} title={post.data.title}>
                <Image src={post.data.images[0]} width={360} height={360} alt={post.data.title} />
                <div class="strip-body">{post.data.title}</div>
              </a>
            ))}
          </div>
        </>
      )
    }

    {/* Section: Tag Clouds */}
    <section class="section-block" style="margin-top: 72px;">
      <div class="sechead">
        <h3>Tags</h3>
        <a href="/tags/">Semua tag →</a>
      </div>
      <div class="tag-cloud">
        {
          sortedTags.map(([name, count]) => (
            <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
              <TagIcon name={name} />
              <span class="tag-name">#{name}</span>
              <span class="tag-count">{count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-intro {
    max-width: 100%;
    padding: 32px 0 0;
  }

  .home-intro h1 {
    font-size: clamp(2.35rem, 5.2vw, 3.6rem);
    line-height: 1.08;
    margin: 0;
    font-family: var(--font-disp);
    letter-spacing: -0.02em;
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    color: var(--ink);
  }

  .home-intro h1 .accent-word {
    color: var(--terra);
  }

  .home-intro-spread {
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    .home-intro-spread {
      columns: 2;
      column-gap: 52px;
      margin-top: 36px;
    }
  }

  .home-intro-spread p {
    margin: 20px 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .home-intro-spread p:first-of-type {
    margin-top: 0;
  }

  .home-intro-spread p:first-of-type::first-letter {
    initial-letter: 2;
    -webkit-initial-letter: 2;
    float: left;
    font-family: var(--font-disp);
    font-size: 3.4rem;
    line-height: 0.85;
    font-weight: 500;
    color: var(--terra);
    margin: 0.04em 0.14em 0 0;
  }

  .home-intro-figure {
    break-inside: avoid;
    margin: 24px 0;
  }

  .home-intro-photo {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 63%;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--sand-2);
  }

  .home-intro-caption {
    font-family: var(--font-disp);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
    margin-top: 10px;
    padding: 0 8px;
  }

  /* Dua Kolom: Sorotan Utama & Tulisan Terkini */
  .home-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-top: 56px;
  }

  @media (min-width: 768px) {
    .home-columns {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (min-width: 1024px) {
    .home-columns {
      gap: 48px;
    }
  }

  .home-columns .section-block {
    margin-top: 0;
  }

  .eyebrow-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--terra);
    background: var(--sand-2);
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--rule);
  }

  .home-entry-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }

  .home-entry-item {
    border-bottom: 1px solid var(--rule);
  }

  .home-entry-card {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    text-decoration: none;
    color: inherit;
  }

  .home-entry-card .card-thumb {
    width: 88px;
    height: 88px;
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    overflow: hidden;
    background: var(--sand-2);
    border: 1px solid var(--rule);
    flex-shrink: 0;
  }

  .home-entry-card .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .home-entry-card:hover .card-thumb img {
    transform: scale(1.06);
  }

  .home-entry-card .card-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }

  .home-entry-card h4 {
    font-family: var(--font-disp);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
    font-variation-settings: 'SOFT' 30, 'WONK' 1;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 1.25em;
    transition: color 0.15s ease;
  }

  @media (min-width: 1024px) {
    .home-entry-card h4 {
      font-size: 1.0625rem;
    }
  }

  .home-entry-card:hover h4 {
    color: var(--terra);
  }

  .home-entry-card .excerpt {
    font-size: 0.84375rem;
    line-height: 1.45;
    color: var(--muted);
    margin: 5px 0 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    text-overflow: ellipsis;
    height: 2.9em;
  }

  .home-entry-card .when {
    font-size: 0.71875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terra-soft);
    display: block;
    margin-top: 5px;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 560px) {
    .home-entry-card {
      grid-template-columns: 80px 1fr;
      gap: 12px;
      padding: 12px 0;
    }
    .home-entry-card .card-thumb {
      width: 80px;
      height: 80px;
    }
  }
</style>
