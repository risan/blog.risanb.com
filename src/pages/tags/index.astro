---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagIcon from '../../components/TagIcon.astro';

const posts = await getCollection('blog');

const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sorted = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags — Risan Bagja" description="Jelajahi catatan berdasarkan tag.">
  <div class="shell" style="max-width: 860px;">
    <div class="page-head">
      <h1>Tags</h1>
      <p class="lede">Jelajahi {sorted.length} tag yang tersebar di seluruh catatan.</p>
    </div>

    <div class="tag-cloud" style="margin-top: 48px; justify-content: center; gap: 12px;">
      {
        sorted.map(([name, count]) => (
          <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
            <TagIcon name={name} />
            <span class="tag-name">#{name}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
