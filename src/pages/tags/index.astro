---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');

const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sorted = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Topik — Risan Bagja" description="Jelajahi catatan berdasarkan topik.">
  <div class="shell">
    <div class="page-head">
      <h1>Topik Catatan</h1>
      <p class="lede">Jelajahi {sorted.length} topik yang tersebar di seluruh catatan.</p>
    </div>

    <div class="tags-pills" style="margin-top: 48px; justify-content: center; gap: 12px;">
      {
        sorted.map(([name, count]) => (
          <a
            href={`/tags/${name}/`}
            style="font-size: 0.9375rem; padding: 6px 16px; border-radius: 999px;"
          >
            #{name} <span style="opacity: 0.65; margin-left: 4px;">({count})</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
