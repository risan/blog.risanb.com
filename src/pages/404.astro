---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan — Risan Bagja"
  description="Halaman yang dicari tidak ditemukan."
>
  <div class="shell">
    <div class="notfound">
      <div class="code">404</div>
      <h1>Halaman Tidak Ditemukan</h1>
      <p>
        Tautan mungkin sudah kedaluwarsa atau catatan telah dipindahkan ke alamat lain. Silakan
        kembali ke beranda atau gunakan pencarian untuk menemukan catatan.
      </p>
      <div style="margin-top: 32px;">
        <a
          href="/"
          style="display: inline-block; background: var(--terra); color: #fff; padding: 8px 20px; border-radius: 999px; text-decoration: none; font-size: 0.9375rem;"
        >
          ← Kembali ke Beranda
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
