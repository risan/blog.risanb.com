---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');

const terms = new Map<string, number>();
for (const post of posts) {
  for (const c of post.data.categories) terms.set(c, (terms.get(c) ?? 0) + 1);
}
const sorted = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const categoryLabels: Record<string, string> = {
  travel: 'Perjalanan',
  writing: 'Tulisan',
  journal: 'Catatan',
  photos: 'Foto',
};
---

<BaseLayout title="Kategori — Risan Bagja" description="Jelajahi catatan berdasarkan kategori.">
  <div class="shell">
    <div class="page-head">
      <h1>Kategori Catatan</h1>
      <p class="lede">Temukan cerita dan tulisan berdasarkan ruang tematik.</p>
    </div>

    <ul class="entries" style="margin-top: 48px;">
      {
        sorted.map(([name, count]) => {
          const label = categoryLabels[name] ?? name;
          return (
            <li>
              <a href={`/categories/${name}/`} class="no-thumb">
                <span>
                  <h4>{label}</h4>
                  <span class="when">{count} catatan</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
