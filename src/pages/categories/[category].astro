---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORY_LABELS, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const terms = new Map<string, Post[]>();
  for (const post of posts) {
    for (const c of post.data.categories) {
      const bucket = terms.get(c);
      if (bucket) bucket.push(post);
      else terms.set(c, [post]);
    }
  }

  return [...terms.entries()].map(([category, entries]) => ({
    params: { category },
    props: {
      category,
      entries: entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category, entries } = Astro.props;
const displayTitle = CATEGORY_LABELS[category] ?? category;
---

<BaseLayout
  title={`${displayTitle} — Risan Bagja`}
  description={`Kumpulan catatan dalam kategori ${displayTitle}.`}
>
  <div class="shell">
    <div class="page-head">
      <p style="margin-bottom: 8px;">
        <a href="/categories/">← Semua kategori</a>
      </p>
      <h1>{displayTitle}</h1>
      <p class="lede">{entries.length} catatan dalam kategori ini.</p>
    </div>

    <PostList posts={entries} twoColumn showCategory={false} />
  </div>
</BaseLayout>
