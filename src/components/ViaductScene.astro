---
// The grass and scree detail textures in static/river/ are CC0, from Poly Haven (see
// static/river/CREDITS.txt). Everything else in the scene is drawn in code.
---

<section class="section-block viaduct" style="margin-top: 72px;" data-viaduct>
  <div class="sechead">
    <h3>Viaduk Spiral Brusio</h3>
    <span class="viaduct-hint">Bernina Express · Swiss</span>
  </div>
  <div class="viaduct-frame" data-viaduct-frame>
    <canvas
      class="viaduct-canvas"
      data-viaduct-canvas
      role="img"
      aria-label="Viaduk spiral Brusio di Swiss, jembatan batu melengkung dengan sembilan lengkungan, dilintasi kereta merah Bernina Express yang bolak-balik"></canvas>
  </div>
</section>

<script>
  import { bootViaduct } from '../scripts/viaduct/boot';

  const section = document.querySelector<HTMLElement>('[data-viaduct]');
  if (section) {
    bootViaduct(section);
  }
</script>

<style>
  .viaduct-hint {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .viaduct:has(.is-fallback) .viaduct-hint {
    display: none;
  }

  .viaduct-frame {
    position: relative;
    margin-top: 20px;
    aspect-ratio: 21 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: var(--sand-2);
    box-shadow: 0 4px 16px rgba(42, 31, 23, 0.07);
  }

  .viaduct-frame.is-fallback {
    background: linear-gradient(135deg, var(--sand-2), #9fb98c);
  }

  .viaduct-canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s ease;
    /* The scene has no controls, so every swipe scrolls the page. */
    touch-action: pan-y;
  }

  .viaduct-frame.is-ready .viaduct-canvas {
    opacity: 1;
  }

  @media (max-width: 819px) {
    .viaduct-frame {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 559px) {
    .viaduct-frame {
      aspect-ratio: 4 / 5;
    }
  }
</style>
