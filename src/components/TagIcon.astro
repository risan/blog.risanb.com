---
import { getTagIconSvg } from '../lib/icons-svg';

interface Props {
  name?: string | null;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
const svg = name ? getTagIconSvg(name) : null;
---

{
  svg && (
    <span
      class={`tech-icon ${className}`.trim()}
      data-tag={name?.toLowerCase().trim()}
      aria-hidden="true"
      set:html={svg}
    />
  )
}
