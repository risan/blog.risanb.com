---
interface MediaItem {
  src: string;
  alt?: string;
  caption?: string;
  type?: 'image' | 'video' | 'youtube';
  width?: number;
  height?: number;
}

interface Props {
  items?: MediaItem[];
  layout?: 'mosaic' | 'justified' | 'masonry' | 'grid';
  loop?: boolean;
  thumbnails?: boolean;
  caption?: string;
  class?: string;
}

const {
  items = [],
  layout = 'mosaic',
  loop = true,
  thumbnails = true,
  caption,
  class: className = '',
} = Astro.props;

const count = items.length;
---

<div
  class:list={['media-gallery', `layout-${layout}`, className]}
  data-layout={layout}
  data-count={count > 0 ? count : undefined}
  data-loop={loop ? 'true' : 'false'}
  data-thumbnails={thumbnails ? 'true' : 'false'}
>
  {
    items.length > 0 ? (
      items.map((item) => {
        const itemCaption = item.caption || item.alt;
        const ar = item.width && item.height ? (item.width / item.height).toFixed(2) : '1.5';
        return (
          <figure
            class="gallery-item"
            data-caption={itemCaption}
            style={`--ar: ${ar};`}
          >
            {item.type === 'video' ? (
              <>
                <video src={item.src} controls={false} preload="metadata" />
                <div class="gallery-video-badge" aria-label="Video">
                  <svg class="w-4 h-4 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </>
            ) : item.type === 'youtube' ? (
              <>
                <div class="w-full h-full aspect-video bg-neutral-900">
                  <iframe
                    src={`https://www.youtube.com/embed/${item.src}`}
                    class="w-full h-full pointer-events-none"
                    title={item.alt || 'Video'}
                  />
                </div>
                <div class="gallery-video-badge" aria-label="YouTube Video">
                  <svg class="w-4 h-4 ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </>
            ) : (
              <img
                src={item.src}
                alt={item.alt || ''}
                loading="lazy"
                decoding="async"
              />
            )}
            {itemCaption && (
              <figcaption class="gallery-caption">{itemCaption}</figcaption>
            )}
          </figure>
        );
      })
    ) : (
      <slot />
    )
  }
  {caption && <div class="media-gallery-caption">{caption}</div>}
</div>
