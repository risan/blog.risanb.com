---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';
import MediaLightbox from '../components/MediaLightbox.vue';
import { Image } from 'astro:assets';
import logoScene from '../assets/eiger/scene.webp';
import logoTrain from '../assets/eiger/train.webp';
import cloudHigh from '../assets/eiger/cloud-1.webp';
import cloudLow from '../assets/eiger/cloud-2.webp';
import cloudRight from '../assets/eiger/cloud-3.webp';
import logoFooter from '../assets/logo-footer.webp';
import footerPanorama from '../assets/footer-panorama.webp';

interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /**
   * Social/OG image. Anything carrying a `src` — an ImageMetadata for a
   * bundle asset, or the result of getImage() for a resized card.
   */
  ogImage?: { src: string } | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
}

const {
  title,
  description = 'Jurnal dan catatan pribadi Risan Bagja.',
  lang = 'id',
  ogImage,
  ogType = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage.src, Astro.site) : undefined;
const nav = [
  { href: '/categories/travel/', label: 'Perjalanan' },
  { href: '/categories/writing/', label: 'Tulisan' },
  { href: '/categories/journal/', label: 'Catatan' },
  { href: '/categories/photos/', label: 'Foto' },
  { href: '/arsip/', label: 'Arsip' },
  { href: '/tentang/', label: 'Tentang' },
] as const;
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
const RAILCAR_SOUND_SOURCE =
  'https://commons.wikimedia.org/wiki/File:BDhe_4-4_%26_Bt_122_at_Lauterbrunnen_station.webm';

// The header logo is layered on one canvas (the scene's size): sky strokes, the still
// scene, then the train. Each cloud drifts across the whole canvas, left to right,
// starting from its painted spot.
const BRAND_WIDTH = 160;
const clouds = [
  { src: cloudHigh, x: 41, y: 4, seconds: 46 },
  { src: cloudLow, x: 161, y: 87, seconds: 38 },
  { src: cloudRight, x: 1015, y: 162, seconds: 54 },
].map(({ src, x, y, seconds }) => {
  const canvas = logoScene;
  const w = src.width;
  const travelled = (x + w) / (canvas.width + w);
  return {
    src,
    width: Math.round((BRAND_WIDTH * w) / canvas.width),
    style: [
      `left: ${(x / canvas.width) * 100}%`,
      `top: ${(y / canvas.height) * 100}%`,
      `width: ${(w / canvas.width) * 100}%`,
      `--from: ${(-(x + w) / w) * 100}%`,
      `--to: ${((canvas.width - x) / w) * 100}%`,
      `animation-duration: ${seconds}s`,
      `animation-delay: -${travelled * seconds}s`,
    ].join('; '),
  };
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbf6ed" />

    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>

    <header class="masthead">
      <div class="shell">
        <a class="brand" href="/">
          <span class="brand-mark">
            <span class="brand-sky">
              {
                clouds.map((cloud) => (
                  <Image
                    class="brand-cloud"
                    src={cloud.src}
                    width={cloud.width}
                    layout="fixed"
                    loading="eager"
                    style={cloud.style}
                    alt=""
                  />
                ))
              }
            </span>
            <Image
              class="brand-scene"
              src={logoScene}
              width={BRAND_WIDTH}
              layout="fixed"
              loading="eager"
              alt=""
            />
            <span class="brand-rail">
              <Image
                class="brand-train"
                src={logoTrain}
                width={BRAND_WIDTH}
                layout="fixed"
                loading="eager"
                alt=""
              />
            </span>
          </span>
          <span class="brand-name">
            <span class="wordmark">Risan Bagja</span>
            <span class="tagline">Dari peron ke peron</span>
          </span>
        </a>
        <nav class="journal" aria-label="Navigasi Utama">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                class="journal-search-btn"
                type="button"
                data-search-open
                aria-label="Cari catatan (Command K)"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Cari</span>
                <kbd data-shortcut-label>Ctrl K</kbd>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div class="footer-main">
          <a class="footer-mark" href="/" aria-label="Beranda">
            <Image src={logoFooter} width={96} layout="fixed" alt="" />
          </a>
          <p class="footer-note">Perjalanan berikutnya sedang disiapkan.</p>
          <nav aria-label="Tautan Terkait">
            <a href="https://risanb.com">Code</a>
            <a href="https://x.com/risanbagja">X</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
        <div class="fine">
          <span>© 2007–{new Date().getFullYear()} Risan Bagja</span>
          <span>
            Suara kereta: potongan rekaman <a href={RAILCAR_SOUND_SOURCE}>virtualMODE</a> dengan
            klakson sintetis, <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>
          </span>
          <a href="#">Kembali ke atas ↑</a>
        </div>
      </div>
      {/* The panorama is flattened onto --sand (#fbf6ed): with transparency kept, this
          fine line art weighs about four times as much. Re-export it if --sand changes. */}
      <Image
        class="footer-art"
        src={footerPanorama}
        widths={[640, 960, 1280, 1600, footerPanorama.width]}
        sizes="100vw"
        alt=""
      />
    </footer>

    <script>
      // The button ships "Ctrl K"; Apple keyboards say ⌘ instead.
      if (/Mac|iPhone|iPad/.test(navigator.userAgent)) {
        document.querySelectorAll('[data-shortcut-label]').forEach((kbd) => {
          kbd.textContent = '⌘K';
        });
      }
    </script>

    <script>
      // The header train shuttles along the painted rail: up slowly, a random pause, down
      // a bit faster, another pause. Distances are canvas pixels of the logo layers
      // (1217x921): the rail's slope, and how far the train must slide to sit past either
      // end of the painted track, where .brand-rail fades it out.
      const CANVAS_WIDTH = 1217;
      const CANVAS_HEIGHT = 921;
      const RAIL_SLOPE = -0.22268;
      const HIDDEN_LEFT = -646;
      const HIDDEN_RIGHT = 663;
      const CLIMB_MS = 18000;
      const DESCENT_MS = 11000;

      const alongRail = (dx: number) =>
        `translate(${(dx / CANVAS_WIDTH) * 100}%, ${((dx * RAIL_SLOPE) / CANVAS_HEIGHT) * 100}%)`;

      const pause = (min: number, max: number) =>
        new Promise((resume) => setTimeout(resume, min + Math.random() * (max - min)));

      function drive(train: HTMLElement, from: number, to: number, duration: number) {
        const run = train.animate([{ transform: alongRail(from) }, { transform: alongRail(to) }], {
          duration,
          fill: 'forwards',
        });
        for (const previous of train.getAnimations()) {
          if (previous !== run) {
            previous.cancel();
          }
        }

        return run.finished;
      }

      // Bumped whenever the reduced-motion preference flips, so a loop sleeping in a
      // pause knows it has been replaced and quits.
      let trip = 0;

      async function shuttle(train: HTMLElement, id: number) {
        for (;;) {
          await pause(1500, 6000);
          if (id !== trip) {
            return;
          }

          await drive(train, HIDDEN_LEFT, HIDDEN_RIGHT, CLIMB_MS);
          await pause(3000, 10000);
          if (id !== trip) {
            return;
          }

          await drive(train, HIDDEN_RIGHT, HIDDEN_LEFT, DESCENT_MS);
        }
      }

      const train = document.querySelector<HTMLElement>('.brand-train');
      const calm = matchMedia('(prefers-reduced-motion: reduce)');

      // Cancelling the running leg rejects its `finished` promise; that is how a loop
      // stops mid-trip, so the rejection is expected. CSS then parks the train: out of
      // sight when motion is allowed, at its painted spot when it is reduced.
      function follow() {
        if (!train) {
          return;
        }

        trip += 1;
        for (const run of train.getAnimations()) {
          run.cancel();
        }

        if (!calm.matches) {
          shuttle(train, trip).catch(() => {});
        }
      }

      calm.addEventListener('change', follow);
      follow();
    </script>

    <script>
      // Hovering the logo sounds the railcar: a horn blast, then a WAB BDhe 4/4 rumbling
      // past. The clip stays under three seconds, so it needs no stop control
      // (WCAG 1.4.2). Browsers allow sound only after the visitor has clicked or typed on the
      // page, so hovers before that stay silent and fetch nothing.
      let railcar: HTMLAudioElement | undefined;

      document.querySelector('.brand')?.addEventListener('mouseenter', () => {
        if (navigator.userActivation?.hasBeenActive === false) {
          return;
        }

        if (!railcar) {
          railcar = new Audio('/audio/wab-bdhe.mp3');
          railcar.volume = 0.45;
        }

        if (!railcar.paused) {
          return;
        }

        railcar.currentTime = 0;
        railcar.play().catch(() => {});
      });
    </script>

    {/* client:idle, not client:load: the palette is worth ~0ms until someone
        actually searches, and the index is fetched on first open rather than on
        hydrate. Astro hydrates this once the browser goes idle. */}
    <SearchModal client:idle />
    <MediaLightbox client:idle />
  </body>
</html>
