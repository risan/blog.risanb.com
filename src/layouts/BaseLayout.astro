---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';

interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /**
   * Social/OG image. Anything carrying a `src` — an ImageMetadata for a
   * bundle asset, or the result of getImage() for a resized card.
   */
  ogImage?: { src: string } | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
}

const {
  title,
  description = 'Catatan perjalanan, renungan harian, ulasan buku, dan cerita-cerita kecil dari Risan Bagja.',
  lang = 'id',
  ogImage,
  ogType = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage.src, Astro.site) : undefined;
const nav = [
  { href: '/categories/travel/', label: 'Perjalanan' },
  { href: '/categories/writing/', label: 'Tulisan' },
  { href: '/categories/journal/', label: 'Catatan' },
  { href: '/categories/photos/', label: 'Foto' },
  { href: '/tags/', label: 'Topik' },
  { href: '/tentang/', label: 'Tentang' },
] as const;
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja — Catatan Perjalanan & Keseharian"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta name="color-scheme" content="light" />
  </head>
  <body>
    <a class="skip-link" href="#main">Lewati ke konten</a>

    <header class="masthead">
      <div class="shell">
        <a class="wordmark" href="/">Risan Bagja</a>
        <span class="tagline">catatan perjalanan &amp; keseharian</span>
        <nav class="journal" aria-label="Navigasi Utama">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <button
                class="journal-search-btn"
                type="button"
                data-search-open
                aria-label="Cari catatan (Command K)"
              >
                <svg
                  width="13"
                  height="13"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Cari</span>
                <kbd>⌘K</kbd>
              </button>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ocean">
      <div class="inner">
        <a class="wordmark" href="/">Risan Bagja</a>
        <div class="tagline">catatan perjalanan &amp; keseharian</div>
        <nav aria-label="Tautan Terkait">
          <a href="https://risanb.com">Code &amp; Tech (risanb.com)</a>
          <a href="https://github.com/risan">GitHub</a>
          <a href="https://twitter.com/risanbagja">Twitter</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <div class="fine">
          <span>© Risan Bagja {new Date().getFullYear()}. Jurnal, perjalanan, dan cerita keseharian.</span>
        </div>
      </div>
    </footer>

    {/* client:idle, not client:load: the palette is worth ~0ms until someone
        actually searches, and the index is fetched on first open rather than on
        hydrate. Astro hydrates this once the browser goes idle. */}
    <SearchModal client:idle />
  </body>
</html>
