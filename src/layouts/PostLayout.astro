---
import BaseLayout from './BaseLayout.astro';
import { getImage, Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Post = CollectionEntry<'blog'>;

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
  /** Plain-text length of the rendered post, for the reading-time estimate. */
  wordCount: number;
  prev?: Post | undefined;
  next?: Post | undefined;
}

const { post, wordCount, prev, next } = Astro.props;
const { title, date, lastmod, description, categories, tags, images, languageCode } = post.data;

const fmt = (d: Date) =>
  d.toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

const updated = lastmod && lastmod > date ? lastmod : null;
const minutes = Math.max(1, Math.round(wordCount / 200));

const cover = images[0];
const ogImage = cover
  ? await getImage({ src: cover, width: 1200, format: 'jpeg', quality: 80 })
  : undefined;

const categoryLabel = (cats: string[]) => {
  if (!cats || cats.length === 0) return 'Catatan';
  const c = cats[0].toLowerCase();
  if (c === 'travel') return 'Perjalanan';
  if (c === 'writing') return 'Tulisan';
  if (c === 'journal') return 'Catatan';
  if (c === 'photos') return 'Foto';
  return cats[0];
};

const primaryCat = categories[0] ?? 'journal';
const primaryCatLabel = categoryLabel(categories);
---

<BaseLayout
  title={`${title} — Risan Bagja`}
  {description}
  lang={languageCode}
  ogType="article"
  {ogImage}
  published={date.toISOString()}
>
  {/* Reading progress bar */}
  <div id="progress" class="progress" style="width: 0%" aria-hidden="true"></div>

  {
    cover ? (
      <>
        <div class="hero">
          <Image src={cover} width={1400} height={700} alt={title} loading="eager" />
          <div class="caption">
            <a href={`/categories/${primaryCat}/`} class="cat-badge">
              {primaryCatLabel}
            </a>
            <h1>{title}</h1>
          </div>
        </div>

        <div class="sheet">
          <article class="journal-article">
            <div class="meta-row">
              <span class="by">
                Oleh <a href="/tentang/">Risan Bagja</a>
              </span>
              <span class="sep">·</span>
              <time datetime={date.toISOString()}>{fmt(date)}</time>
              {updated && (
                <>
                  <span class="sep">·</span>
                  <span>Diperbarui {fmt(updated)}</span>
                </>
              )}
              <span class="sep">·</span>
              <span>{minutes} menit baca</span>
            </div>

            <div class="journal-content">
              <slot />
            </div>

            {/* Handwritten signature signoff */}
            <div class="signoff">
              <span class="sig">Risan Bagja</span>
              <div class="line" />
            </div>

            {/* Author card */}
            <div class="author-card">
              <img src="/img/risan.jpg" alt="Risan Bagja" width="80" height="80" />
              <div>
                <h3>Risan Bagja</h3>
                <p>
                  Menulis catatan perjalanan, renungan harian, ulasan buku, dan cerita-cerita kecil
                  dari Bandung. Tulisan teknis seputar pemrograman ada di{' '}
                  <a href="https://risanb.com">risanb.com</a>.
                </p>
              </div>
            </div>

            {/* Topic tags pills */}
            {tags.length > 0 && (
              <div class="tags-pills">
                <span class="lbl">Topik:</span>
                {tags.map((t) => (
                  <a href={`/tags/${t}/`}>#{t}</a>
                ))}
              </div>
            )}

            {/* Next / Prev navigation */}
            {(prev || next) && (
              <nav class="nextup" aria-label="Catatan Lainnya">
                {next && (
                  <div class="item">
                    <span class="lbl">Catatan Selanjutnya</span>
                    <a href={`/${next.id.replace(/\/index$/, '')}/`}>{next.data.title}</a>
                  </div>
                )}
                {prev && (
                  <div class="item">
                    <span class="lbl">Catatan Sebelumnya</span>
                    <a href={`/${prev.id.replace(/\/index$/, '')}/`}>{prev.data.title}</a>
                  </div>
                )}
              </nav>
            )}
          </article>
        </div>
      </>
    ) : (
      <div class="sheet" style="margin-top: 0; padding-top: 0;">
        <header class="simple-post-head">
          <a href={`/categories/${primaryCat}/`} class="cat-badge">
            {primaryCatLabel}
          </a>
          <h1>{title}</h1>
        </header>

        <article class="journal-article" style="margin-top: 32px;">
          <div class="meta-row">
            <span class="by">
              Oleh <a href="/tentang/">Risan Bagja</a>
            </span>
            <span class="sep">·</span>
            <time datetime={date.toISOString()}>{fmt(date)}</time>
            {updated && (
              <>
                <span class="sep">·</span>
                <span>Diperbarui {fmt(updated)}</span>
              </>
            )}
            <span class="sep">·</span>
            <span>{minutes} menit baca</span>
          </div>

          <div class="journal-content">
            <slot />
          </div>

          {/* Handwritten signature signoff */}
          <div class="signoff">
            <span class="sig">Risan Bagja</span>
            <div class="line" />
          </div>

          {/* Author card */}
          <div class="author-card">
            <img src="/img/risan.jpg" alt="Risan Bagja" width="80" height="80" />
            <div>
              <h3>Risan Bagja</h3>
              <p>
                Menulis catatan perjalanan, renungan harian, ulasan buku, dan cerita-cerita kecil
                dari Bandung. Tulisan teknis seputar pemrograman ada di{' '}
                <a href="https://risanb.com">risanb.com</a>.
              </p>
            </div>
          </div>

          {/* Topic tags pills */}
          {tags.length > 0 && (
            <div class="tags-pills">
              <span class="lbl">Topik:</span>
              {tags.map((t) => (
                <a href={`/tags/${t}/`}>#{t}</a>
              ))}
            </div>
          )}

          {/* Next / Prev navigation */}
          {(prev || next) && (
            <nav class="nextup" aria-label="Catatan Lainnya">
              {next && (
                <div class="item">
                  <span class="lbl">Catatan Selanjutnya</span>
                  <a href={`/${next.id.replace(/\/index$/, '')}/`}>{next.data.title}</a>
                </div>
              )}
              {prev && (
                <div class="item">
                  <span class="lbl">Catatan Sebelumnya</span>
                  <a href={`/${prev.id.replace(/\/index$/, '')}/`}>{prev.data.title}</a>
                </div>
              )}
            </nav>
          )}
        </article>
      </div>
    )
  }

  {/* Client-side progress indicator */}
  <script>
    const bar = document.getElementById('progress');
    if (bar) {
      window.addEventListener(
        'scroll',
        () => {
          const total = document.documentElement.scrollHeight - window.innerHeight;
          if (total > 0) {
            const pct = Math.min(100, Math.max(0, (window.scrollY / total) * 100));
            bar.style.width = `${pct}%`;
          }
        },
        { passive: true },
      );
    }
  </script>
</BaseLayout>
